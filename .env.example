# SynapseIP Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key (generate a random string for production)
# For development, a random key will be generated automatically
SECRET_KEY=your-secret-key-here

# Database Configuration
# For local development, SQLite is used by default
# For production, use DATABASE_URL with PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/synapseip

# LM Studio Configuration (Local LLM - Flash equivalent)
LMSTUDIO_API_BASE=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=dummy_key
LMSTUDIO_MODEL=qwen3.6-35b-a3b-mlx
LMSTUDIO_EMBED_MODEL=nomic-embed-text

# vLLM Configuration (Local LLM - Pro equivalent)
VLLM_API_BASE=http://192.168.1.151:8000/v1
VLLM_API_KEY=dummy_key
VLLM_MODEL=qwen3.5-122b

# Circuit Breaker Settings (for local LLM usage)
# Maximum operations per day per user (prevents runaway loops)
CIRCUIT_BREAKER_OPS_LIMIT=50
# Maximum tokens processed per day per user
CIRCUIT_BREAKER_TOKEN_LIMIT=1000000

# Data Directory (for database storage)
# DATA_DIR=.

# Migration Source (optional - for Neon to SQLite migration)
# MIGRATION_SOURCE_URL=postgresql://user:password@host:5432/database

# Render/Production Settings
# These are automatically set by Render
# DATABASE_URL will be provided by Render's PostgreSQL addon

# CORS Configuration
# Comma-separated list of allowed origins (for production)
# For local development, include your frontend URL
# Example: http://localhost:3000,http://localhost:8080,https://yourapp.render.com
# For Chrome Extension, add: chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
